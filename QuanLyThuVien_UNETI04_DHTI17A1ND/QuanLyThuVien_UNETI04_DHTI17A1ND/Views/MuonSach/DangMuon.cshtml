@model QuanLyThuVien_UNETI04_DHTI17A1ND.Models.ViewModels.DangMuonViewModel

@{
    ViewData["Title"] = "Sách đang mượn";
}

<h3 class="mb-3">Sách đang mượn</h3>

@if (TempData["ThanhCong"] != null)
{
    <div class="alert alert-success">@TempData["ThanhCong"]</div>
}

<h5 class="mt-4">Yêu cầu chờ xác nhận (@Model.ChoXacNhan.Count)</h5>
<partial name="_BangPhieuMuon" model="Model.ChoXacNhan" />

<h5 class="mt-4">Đang mượn (@Model.DangMuon.Count)</h5>
<partial name="_BangPhieuMuon" model="Model.DangMuon" />

<div class="mt-3">
    <a asp-action="LichSu" class="btn btn-outline-secondary">Xem lịch sử mượn trả</a>

    <!-- Nút Quay lại trang trước đó -->
    <button type="button" onclick="history.back()" class="btn btn-secondary ms-2">
        <i class="bi bi-arrow-left"></i> Quay lại
    </button>
</div>