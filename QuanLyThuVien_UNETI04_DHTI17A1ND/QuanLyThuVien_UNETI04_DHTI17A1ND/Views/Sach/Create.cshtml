@* Họ và tên: Vũ Duy Anh *@
@* Mã sinh viên: 23203100073 *@
@* Nội dung thực hiện: Thêm sách mới *@

@model QuanLyThuVien_UNETI04_DHTI17A1ND.Models.Entities.Sach
@{
    ViewData["Title"] = "Thêm sách";
}

<h1 class="mb-4">Thêm sách mới</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" class="needs-validation">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="TenSach" class="form-label fw-bold"></label>
                <input asp-for="TenSach" class="form-control" placeholder="Nhập tên sách..." />
                <span asp-validation-for="TenSach" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MaTheLoai" class="form-label fw-bold"></label>
                <select asp-for="MaTheLoai" class="form-select" asp-items="ViewBag.DanhSachTheLoai">
                    <option value="">-- Chọn thể loại --</option>
                </select>
                <span asp-validation-for="MaTheLoai" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TacGia" class="form-label fw-bold"></label>
                <input asp-for="TacGia" class="form-control" placeholder="Nhập tên tác giả..." />
                <span asp-validation-for="TacGia" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NhaXuatBan" class="form-label fw-bold"></label>
                <input asp-for="NhaXuatBan" class="form-control" placeholder="Nhập nhà xuất bản..." />
                <span asp-validation-for="NhaXuatBan" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NamXuatBan" class="form-label fw-bold"></label>
                <input asp-for="NamXuatBan" type="number" class="form-control" placeholder="VD: 2020" />
                <span asp-validation-for="NamXuatBan" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SoLuong" class="form-label fw-bold"></label>
                    <input asp-for="SoLuong" class="form-control" placeholder="Số lượng" />
                    <span asp-validation-for="SoLuong" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SoLuongCon" class="form-label fw-bold"></label>
                    <input asp-for="SoLuongCon" class="form-control" placeholder="Số lượng còn" />
                    <span asp-validation-for="SoLuongCon" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="GiaSach" class="form-label fw-bold"></label>
                <input asp-for="GiaSach" class="form-control" placeholder="VD: 85000" />
                <span asp-validation-for="GiaSach" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MoTa" class="form-label fw-bold"></label>
                <textarea asp-for="MoTa" class="form-control" rows="4" placeholder="Nhập mô tả..."></textarea>
                <span asp-validation-for="MoTa" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TrangThai" class="form-label fw-bold"></label>
                <select asp-for="TrangThai" class="form-select" asp-items="ViewBag.DanhSachTrangThai"></select>
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>

            <div class="mt-4 mb-5 pb-5 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">Lưu</button>
                <a asp-action="Index" class="btn btn-secondary px-4">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}