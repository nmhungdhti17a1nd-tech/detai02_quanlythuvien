@* Nội dung thực hiện: Thêm sách mới *@

@model QuanLyThuVien_UNETI04_DHTI17A1ND.Models.Entities.Sach
@{
    ViewData["Title"] = "Thêm sách";
}

<h1>Thêm sách mới</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="TenSach" class="form-label"></label>
                <input asp-for="TenSach" class="form-control" />
                <span asp-validation-for="TenSach" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MaTheLoai" class="form-label"></label>
                <select asp-for="MaTheLoai" class="form-select" asp-items="ViewBag.DanhSachTheLoai">
                    <option value="">-- Chọn thể loại --</option>
                </select>
                <span asp-validation-for="MaTheLoai" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TacGia" class="form-label"></label>
                <input asp-for="TacGia" class="form-control" />
                <span asp-validation-for="TacGia" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NhaXuatBan" class="form-label"></label>
                <input asp-for="NhaXuatBan" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="NamXuatBan" class="form-label"></label>
                <input asp-for="NamXuatBan" type="number" class="form-control" />
                <span asp-validation-for="NamXuatBan" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SoLuong" class="form-label"></label>
                <input asp-for="SoLuong" class="form-control" />
                <span asp-validation-for="SoLuong" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SoLuongCon" class="form-label"></label>
                <input asp-for="SoLuongCon" class="form-control" />
                <span asp-validation-for="SoLuongCon" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GiaSach" class="form-label"></label>
                <input asp-for="GiaSach" class="form-control" />
                <span asp-validation-for="GiaSach" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MoTa" class="form-label"></label>
                <textarea asp-for="MoTa" class="form-control" rows="4"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="TrangThai" class="form-label"></label>
                <select asp-for="TrangThai" class="form-select" asp-items="ViewBag.DanhSachTrangThai"></select>
            </div>

            <button type="submit" class="btn btn-primary">Lưu</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}