@* Họ và tên: Vũ Duy Anh *@
@* Mã sinh viên: 23203100073 *@
@* Nội dung thực hiện: Chi tiết sách *@

@model QuanLyThuVien_UNETI04_DHTI17A1ND.Models.Entities.Sach
@{
    ViewData["Title"] = "Chi tiết sách";
}

<h1>Chi tiết sách</h1>
0
<div class="row">
    <!-- ===== CỘT ẢNH BÌA ===== -->
    <div class="col-md-4 text-center mb-4">
        <img src="/images/sach/@(Model.MaSach).jpg"
             onerror="this.onerror=null; this.src='https://via.placeholder.com/300x400?text=@Uri.EscapeDataString(Model.TenSach)';"
             class="img-fluid rounded shadow"
             style="max-height:400px; object-fit:cover;"
             alt="@Model.TenSach" />
    </div>

    <!-- ===== CỘT THÔNG TIN ===== -->
    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-3">Mã sách</dt>
            <dd class="col-sm-9">@Model.MaSach</dd>

            <dt class="col-sm-3">Tên sách</dt>
            <dd class="col-sm-9">@Model.TenSach</dd>

            <dt class="col-sm-3">Thể loại</dt>
            <dd class="col-sm-9">@Model.TheLoai?.TenTheLoai</dd>

            <dt class="col-sm-3">Tác giả</dt>
            <dd class="col-sm-9">@Model.TacGia</dd>

            <dt class="col-sm-3">Nhà xuất bản</dt>
            <dd class="col-sm-9">@Model.NhaXuatBan</dd>

            <dt class="col-sm-3">Năm xuất bản</dt>
            <dd class="col-sm-9">@Model.NamXuatBan</dd>

            <dt class="col-sm-3">Số lượng</dt>
            <dd class="col-sm-9">@Model.SoLuong</dd>

            <dt class="col-sm-3">Số lượng còn</dt>
            <dd class="col-sm-9">@Model.SoLuongCon</dd>

            <dt class="col-sm-3">Giá sách</dt>
            <dd class="col-sm-9">@Model.GiaSach.ToString("N0") đ</dd>

            <dt class="col-sm-3">Mô tả</dt>
            <dd class="col-sm-9">@Model.MoTa</dd>

            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9">
                @(Model.TrangThai == 0 ? "Đang phục vụ" : Model.TrangThai == 1 ? "Tạm ngừng" : "Ngừng phục vụ")
            </dd>
        </dl>

        <div class="mt-3">
            <!-- Chỉ hiển thị nút Mượn sách nếu là Độc giả (không phải Admin) và sách đang phục vụ -->
            @if (Context.Session.GetString("VaiTro") == "DocGia" && Model.TrangThai == 0 && Model.SoLuongCon > 0)
            {
                <a asp-controller="MuonSach" asp-action="DangKy" asp-route-maSach="@Model.MaSach" class="btn btn-success">Mượn sách</a>
            }
            <button type="button" onclick="history.back();" class="btn btn-secondary">Quay lại</button>
        </div>
    </div>
</div>