@* Họ và tên: Nguyễn Mạnh Hùng *@
@* Mã sinh viên: 23203100075 *@
@* Nội dung thực hiện: Trang chủ - Hiển thị sách từ database *@

@model QuanLyThuVien_UNETI04_DHTI17A1ND.Models.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Trang chủ";
    var vaiTro = Context.Session.GetString("VaiTro");
    var hoTen = Context.Session.GetString("HoTen");
    var daDangNhap = !string.IsNullOrEmpty(vaiTro);
    var laAdmin = vaiTro == "Admin";
    var laDocGia = vaiTro == "DocGia";
}

<!-- ===== BANNER ===== -->
<div class="text-center text-white mb-5"
     style="background: linear-gradient(135deg, #1e3c72, #2a5298); padding: 50px 0;">
    <div class="container py-4">
        <h1 class="display-4 fw-bold">Thư Viện UNETI</h1>
        <p class="lead">Khám phá kho tàng tri thức với hàng ngàn đầu sách</p>

        @if (!daDangNhap)
        {
            <div class="mt-4">
                <a asp-controller="Account" asp-action="Login" class="btn btn-light btn-lg me-2">
                    Đăng nhập
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg">
                    Đăng ký
                </a>
            </div>
        }
        else
        {
            <p class="mt-3 mb-3">
                Xin chào, <strong>@hoTen</strong> (<span class="badge bg-warning text-dark">@vaiTro</span>)
            </p>
            <div>
                @if (laAdmin)
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-warning btn-lg me-2">Dashboard</a>
                    <a asp-controller="PhieuMuon" asp-action="Index" class="btn btn-light btn-lg me-2">Phiếu mượn</a>
                    <a asp-controller="ThongKe" asp-action="Index" class="btn btn-info btn-lg">Thống kê</a>
                }
                else if (laDocGia)
                {
                    <a asp-controller="MuonSach" asp-action="DangMuon" class="btn btn-light btn-lg me-2">Sách đang mượn</a>
                    <a asp-controller="MuonSach" asp-action="LichSu" class="btn btn-outline-light btn-lg">Lịch sử mượn</a>
                }
                <a asp-controller="Account" asp-action="Logout" class="btn btn-danger btn-lg ms-2">Đăng xuất</a>
            </div>
        }
    </div>
</div>

<!-- ===== SÁCH NỔI BẬT (LẤY TỪ DB) ===== -->
<div class="container mb-5">
    <h2 class="text-center mb-4">📚 Sách nổi bật</h2>

    @if (!Model.SachNoiBat.Any())
    {
        <div class="alert alert-info text-center">
            Chưa có sách nào trong thư viện.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var s in Model.SachNoiBat)
            {
                var sapHet = s.SoLuongCon > 0 && s.SoLuongCon <= 5;

                var badgeText = sapHet ? "Sắp hết" : "Còn sách";
                var badgeClass = sapHet ? "bg-warning text-dark" : "bg-success";

                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="https://via.placeholder.com/300x400?text=@Uri.EscapeDataString(s.TenSach)"
                             class="card-img-top" alt="@s.TenSach">
                        <div class="card-body">
                            <h5 class="card-title">@s.TenSach</h5>
                            <p class="card-text text-muted mb-1">
                                <small>Tác giả: @s.TacGia</small>
                            </p>
                            <p class="card-text text-muted mb-2">
                                <small>Thể loại: @s.TheLoai?.TenTheLoai</small>
                            </p>
                            <p class="card-text">
                                <span class="badge @badgeClass">@badgeText</span>
                                <small class="text-muted">(còn @s.SoLuongCon cuốn)</small>
                            </p>
                            <p class="card-text fw-bold text-danger">
                                @s.GiaSach.ToString("N0") VNĐ
                            </p>
                        </div>
                        <div class="card-footer bg-white">
                            <a asp-controller="Sach" asp-action="Details" asp-route-id="@s.MaSach"
                               class="btn btn-primary btn-sm">
                                Xem chi tiết
                            </a>

                            @if (laDocGia)
                            {
                                <a asp-controller="MuonSach" asp-action="DangKy" asp-route-id="@s.MaSach"
                                   class="btn btn-outline-success btn-sm">
                                    Mượn sách
                                </a>
                            }
                            else if (!daDangNhap)
                            {
                                <a asp-controller="Account" asp-action="Login"
                                   class="btn btn-outline-success btn-sm">
                                    Đăng nhập để mượn
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-3">
            <a asp-controller="Sach" asp-action="Index" class="btn btn-outline-primary btn-lg">
                Xem tất cả sách
            </a>
        </div>
    }
</div>

<!-- ===== THÔNG TIN THƯ VIỆN (LẤY TỪ DB) ===== -->
<div class="bg-light py-5">
    <div class="container">
        <h2 class="text-center mb-4">🏛️ Về thư viện</h2>
        <div class="row text-center">
            <div class="col-md-4">
                <h3 class="text-primary">@Model.TongDauSach</h3>
                <p>Đầu sách</p>
            </div>
            <div class="col-md-4">
                <h3 class="text-success">@Model.TongDocGia</h3>
                <p>Độc giả</p>
            </div>
            <div class="col-md-4">
                <h3 class="text-warning">@Model.TongTheLoai</h3>
                <p>Thể loại</p>
            </div>
        </div>
    </div>
</div>