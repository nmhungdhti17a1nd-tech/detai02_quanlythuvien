<!-- ===== BANNER ===== -->
<div class="banner text-center text-white mb-5">
    <div class="container py-5">
        <h1 class="display-4 fw-bold">Thư Viện UNETI</h1>
        <p class="lead">Khám phá kho tàng tri thức với hàng ngàn đầu sách</p>
        <a href="#danh-sach-sach" class="btn btn-light btn-lg mt-3">
