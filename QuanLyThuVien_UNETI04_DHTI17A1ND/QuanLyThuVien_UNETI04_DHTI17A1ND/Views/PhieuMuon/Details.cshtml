@* Họ và tên: Nguyễn Mạnh Hùng *@
@* Mã sinh viên: 23203100075 *@
@* Nội dung thực hiện: Module 4 - Chi tiết phiếu mượn *@

@model QuanLyThuVien_UNETI04_DHTI17A1ND.Models.Entities.PhieuMuon
@{
    ViewData["Title"] = "Chi tiết phiếu mượn";

    string GetTrangThaiText(int tt) => tt switch
    {
        0 => "Chờ xác nhận",
        1 => "Đang mượn",
        2 => "Đã trả",
        3 => "Đã hủy",
        _ => "?"
    };
}

<h2>Chi tiết phiếu mượn #@Model.MaPhieuMuon</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p><strong>Độc giả:</strong> @Model.DocGia?.HoTen</p>
                <p><strong>Ngày mượn:</strong> @Model.NgayMuon.ToString("dd/MM/yyyy")</p>
            </div>
            <div class="col-md-6">
                <p><strong>Hạn trả:</strong> @Model.HanTra.ToString("dd/MM/yyyy")</p>
                <p><strong>Trạng thái:</strong> <span class="badge bg-info">@GetTrangThaiText(Model.TrangThai)</span></p>
            </div>
        </div>
    </div>
</div>

<h4>Danh sách sách mượn</h4>
<table class="table table-bordered">
    <thead class="table-light">
        <tr>
            <th>Tên sách</th>
            <th>Tác giả</th>
            <th>Số lượng mượn</th>
            <th>Ngày trả</th>
            <th>Tình trạng trả</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ct in Model.ChiTietPhieuMuons ?? new List<QuanLyThuVien_UNETI04_DHTI17A1ND.Models.Entities.ChiTietPhieuMuon>())
        {
            <tr>
                <td>@ct.Sach?.TenSach</td>
                <td>@ct.Sach?.TacGia</td>
                <td>@ct.SoLuongMuon</td>
                <td>@(ct.NgayTra?.ToString("dd/MM/yyyy") ?? "Chưa trả")</td>
                <td>@(ct.TinhTrangTra ?? "—")</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    @if (Model.TrangThai == 0)
    {
        <form asp-action="XacNhanMuon" asp-route-id="@Model.MaPhieuMuon" method="post" class="d-inline">
            <button type="submit" class="btn btn-success"
                    onclick="return confirm('Xác nhận mượn phiếu này?')">
                Xác nhận mượn
            </button>
        </form>
        <form asp-action="HuyPhieu" asp-route-id="@Model.MaPhieuMuon" method="post" class="d-inline">
            <button type="submit" class="btn btn-danger"
                    onclick="return confirm('Hủy phiếu này?')">
                Hủy phiếu
            </button>
        </form>
    }
    @if (Model.TrangThai == 1)
    {
        <a asp-action="TraSach" asp-route-id="@Model.MaPhieuMuon" class="btn btn-warning">Trả sách</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</div>