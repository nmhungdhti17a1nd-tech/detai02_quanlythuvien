@* Nội dung thực hiện: Module 4 - Trả sách *@

@model QuanLyThuVien_UNETI04_DHTI17A1ND.Models.ViewModels.TraSachViewModel
@{
    ViewData["Title"] = "Trả sách";
}

<h2>Trả sách - Phiếu #@Model.MaPhieuMuon</h2>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Độc giả:</strong> @Model.TenDocGia</p>
        <p><strong>Ngày mượn:</strong> @Model.NgayMuon.ToString("dd/MM/yyyy")</p>
        <p><strong>Hạn trả:</strong> @Model.HanTra.ToString("dd/MM/yyyy")</p>
    </div>
</div>

<form asp-action="TraSach" asp-route-id="@Model.MaPhieuMuon" method="post">
    <input type="hidden" asp-for="MaPhieuMuon" />
    <input type="hidden" asp-for="TenDocGia" />
    <input type="hidden" asp-for="NgayMuon" />
    <input type="hidden" asp-for="HanTra" />

    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Tên sách</th>
                <th>Tác giả</th>
                <th>Số lượng mượn</th>
                <th style="width: 200px;">Ngày trả</th>
                <th style="width: 200px;">Tình trạng</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.DanhSachSach.Count; i++)
            {
                <tr>
                    <td>
                        @Model.DanhSachSach[i].TenSach
                        <input type="hidden" asp-for="DanhSachSach[i].MaChiTiet" />
                        <input type="hidden" asp-for="DanhSachSach[i].TenSach" />
                        <input type="hidden" asp-for="DanhSachSach[i].TacGia" />
                        <input type="hidden" asp-for="DanhSachSach[i].SoLuongMuon" />
                    </td>
                    <td>@Model.DanhSachSach[i].TacGia</td>
                    <td>@Model.DanhSachSach[i].SoLuongMuon</td>
                    <td>
                        <input asp-for="DanhSachSach[i].NgayTra" type="date" class="form-control" />
                        <span asp-validation-for="DanhSachSach[i].NgayTra" class="text-danger"></span>
                    </td>
                    <td>
                        <select asp-for="DanhSachSach[i].TinhTrangTra" class="form-select">
                            <option value="Tốt">Tốt</option>
                            <option value="Hư hỏng">Hư hỏng</option>
                            <option value="Mất">Mất</option>
                        </select>
                        <span asp-validation-for="DanhSachSach[i].TinhTrangTra" class="text-danger"></span>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary"
            onclick="return confirm('Xác nhận trả sách?')">
        Xác nhận trả sách
    </button>
    <a asp-action="Details" asp-route-id="@Model.MaPhieuMuon" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}