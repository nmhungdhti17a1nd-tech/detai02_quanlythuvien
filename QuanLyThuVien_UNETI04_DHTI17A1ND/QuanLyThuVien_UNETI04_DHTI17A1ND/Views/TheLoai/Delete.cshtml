@* Họ và tên: Chu Công Đạt *@
@* Mã sinh viên: [MSSV của bạn] *@
@* Nội dung thực hiện: Module 1 - Xóa thể loại *@

@model QuanLyThuVien_UNETI04_DHTI17A1ND.Models.Entities.TheLoai

@{
    ViewData["Title"] = "Xóa thể loại";
}

<h2 class="mt-4 text-danger">Xóa thể loại</h2>
<h4>Bạn có chắc chắn muốn xóa thể loại này không?</h4>

<div class="card mt-3">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Mã thể loại</dt>
            <dd class="col-sm-9">@Model.MaTheLoai</dd>

            <dt class="col-sm-3">Tên thể loại</dt>
            <dd class="col-sm-9">@Model.TenTheLoai</dd>

            <dt class="col-sm-3">Mô tả</dt>
            <dd class="col-sm-9">@Model.MoTa</dd>

            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9">
                @if (Model.TrangThai)
                {
                    <span class="badge bg-success">Đang dùng</span>
                }
                else
                {
                    <span class="badge bg-secondary">Ngừng dùng</span>
                }
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="MaTheLoai" />
    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash"></i> Xóa
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</form>