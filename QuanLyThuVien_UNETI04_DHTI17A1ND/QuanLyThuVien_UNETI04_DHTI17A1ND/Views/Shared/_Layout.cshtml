@* Họ và tên: Chu Công Đạt *@
@* Mã sinh viên: [MSSV của bạn] *@
@* Nội dung thực hiện: Module 1 - Layout menu theo vai trò *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Thư Viện UNETI</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyThuVien_UNETI04_DHTI17A1ND.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book"></i> Thư Viện UNETI
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Menu bên trái -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Sach" asp-action="Index">
                                <i class="bi bi-book"></i> Sách
                            </a>
                        </li>

                        @* Menu dropdown dành riêng cho Admin *@
                        @if (Context.Session.GetString("VaiTro") == "Admin")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="dropdownQuanLy" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear"></i> Quản lý
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="dropdownQuanLy">
                                    <li>
                                        <a class="dropdown-item" asp-controller="TheLoai" asp-action="Index">
                                            <i class="bi bi-tags"></i> Thể loại
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="DocGia" asp-action="Index">
                                            <i class="bi bi-people"></i> Độc giả
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="PhieuMuon" asp-action="Index">
                                            <i class="bi bi-receipt"></i> Phiếu mượn
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">
                                            <i class="bi bi-speedometer2"></i> Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="ThongKe" asp-action="Index">
                                            <i class="bi bi-bar-chart"></i> Thống kê
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-info-circle"></i> Giới thiệu
                            </a>
                        </li>
                    </ul>

                    <!-- Menu bên phải -->
                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("VaiTro") == "DocGia")
                        {
                            @* Dropdown gọn cho Độc giả *@
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center text-dark"
                                   href="#" id="dropdownUser" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5 me-1"></i>
                                    <span>@Context.Session.GetString("HoTen")</span>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-1"
                                    aria-labelledby="dropdownUser"
                                    style="min-width: 230px; border-radius: 10px;">

                                    @* Header gọn *@
                                    <li class="p-2 mb-1 bg-white rounded-2 shadow-sm border">
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="bi bi-person-circle text-primary" style="font-size: 2rem;"></i>
                                            <div class="ms-2">
                                                <strong class="d-block" style="font-size: 0.9rem;">@Context.Session.GetString("HoTen")</strong>
                                                <small class="text-muted" style="font-size: 0.75rem;">Độc giả</small>
                                            </div>
                                        </div>
                                        <a class="btn btn-light w-100 fw-semibold rounded-2 d-flex align-items-center justify-content-center"
                                           asp-controller="DocGia" asp-action="ThongTinCaNhan"
                                           style="border: none; background-color: #e4e6eb; font-size: 0.8rem; padding: 4px;">
                                            <i class="bi bi-person-circle me-1"></i>
                                            Xem trang cá nhân
                                        </a>
                                    </li>

                                    @* Menu items gọn *@
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center py-1 rounded-2"
                                           asp-controller="MuonSach" asp-action="DangMuon"
                                           style="font-size: 0.85rem;">
                                            <span class="d-flex align-items-center justify-content-center rounded-circle bg-secondary bg-opacity-10 me-2"
                                                  style="width: 28px; height: 28px;">
                                                <i class="bi bi-journal-check" style="font-size: 0.9rem;"></i>
                                            </span>
                                            <span>Sách đang mượn</span>
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item d-flex align-items-center py-1 rounded-2"
                                           asp-controller="MuonSach" asp-action="LichSu"
                                           style="font-size: 0.85rem;">
                                            <span class="d-flex align-items-center justify-content-center rounded-circle bg-secondary bg-opacity-10 me-2"
                                                  style="width: 28px; height: 28px;">
                                                <i class="bi bi-clock-history" style="font-size: 0.9rem;"></i>
                                            </span>
                                            <span>Lịch sử mượn</span>
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item d-flex align-items-center py-1 rounded-2"
                                           asp-controller="DocGia" asp-action="ThongTinCaNhan"
                                           style="font-size: 0.85rem;">
                                            <span class="d-flex align-items-center justify-content-center rounded-circle bg-secondary bg-opacity-10 me-2"
                                                  style="width: 28px; height: 28px;">
                                                <i class="bi bi-gear" style="font-size: 0.9rem;"></i>
                                            </span>
                                            <span>Cài đặt thông tin</span>
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider my-1"></li>

                                    @* Đăng xuất *@
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center py-1 rounded-2 text-danger"
                                           asp-controller="Account" asp-action="Logout"
                                           style="font-size: 0.85rem;">
                                            <span class="d-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10 me-2"
                                                  style="width: 28px; height: 28px;">
                                                <i class="bi bi-box-arrow-right text-danger" style="font-size: 0.9rem;"></i>
                                            </span>
                                            <span>Đăng xuất</span>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else if (Context.Session.GetString("VaiTro") == "Admin")
                        {
                            @* Admin: hiển thị đơn giản *@
                            <li class="nav-item">
                                <span class="nav-link text-dark">
                                    <i class="bi bi-person-circle"></i>
                                    Xin chào, <strong>@Context.Session.GetString("HoTen")</strong>
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                </a>
                            </li>
                        }
                        else
                        {
                            @* Chưa đăng nhập *@
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm mt-1 me-2" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm mt-1" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus"></i> Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container text-center py-3">
            &copy; 2026 - <strong>Thư Viện UNETI</strong> -
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Giới thiệu</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>